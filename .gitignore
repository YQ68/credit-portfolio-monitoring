.venv/
__pycache__/
.ipynb_checkpoints/

# Dữ liệu Kaggle không được đưa lên GitHub.
# Dùng data/* chứ không dùng data/: git không thể re-include file nằm trong
# thư mục đã bị loại, nên phải loại từng mục con rồi mới mở lại data/export/.
data/*
!data/export/
data/export/*
# Ngoại lệ: 5 file CSV tổng hợp nhỏ (~1,4 MB) để PBIP mở được ngay sau khi clone
!data/export/*.csv
*.duckdb
*.duckdb.wal

# Power BI PBIP: file cục bộ do Desktop ghi, không đưa lên git (khuyến nghị của Microsoft).
# localSettings.json chứa securityBindingsSignature gắn với tài khoản Windows của chủ máy.
# cache.abf là bản nhị phân của dữ liệu đã nạp, đổi mỗi lần mở Desktop.
# editorSettings.json thì giữ lại theo dõi.
**/.pbi/localSettings.json
**/.pbi/cache.abf
