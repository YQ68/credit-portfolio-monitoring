.venv/
__pycache__/

# Bí mật và cấu hình cục bộ, phòng trường hợp lỡ đặt vào thư mục repo
.env
kaggle.json
access_token
credentials.json

# File tạm của hệ điều hành, Office và editor
~$*
Thumbs.db
.DS_Store
.vscode/
*.log

# Bản Power BI dạng file nén; repo dùng PBIP dạng văn bản
*.pbix

# Dữ liệu Kaggle không được đưa lên GitHub.
# Dùng data/* chứ không dùng data/: git không thể re-include file nằm trong
# thư mục đã bị loại, nên phải loại từng mục con rồi mới mở lại data/export/.
data/*
!data/export/
data/export/*
# Ngoại lệ: các bảng tổng hợp nhỏ để dashboard và PBIP có dữ liệu ngay sau khi clone
# (PBIP vẫn cần sửa tham số DataFolder, xem powerbi/README.md), và findings.json là
# nguồn số liệu duy nhất cho các câu kết luận.
!data/export/*.csv
!data/export/findings.json
*.duckdb
*.duckdb.wal

# Power BI PBIP: file cục bộ do Desktop ghi, không đưa lên git (khuyến nghị của Microsoft).
# localSettings.json chứa securityBindingsSignature gắn với tài khoản Windows của chủ máy.
# cache.abf là bản nhị phân của dữ liệu đã nạp, đổi mỗi lần mở Desktop.
# editorSettings.json thì giữ lại theo dõi.
**/.pbi/localSettings.json
**/.pbi/cache.abf
